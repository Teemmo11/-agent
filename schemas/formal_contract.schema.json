{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "contract_id",
    "source_spec_id",
    "function_id",
    "precondition_expr",
    "ensures",
    "required_snapshots",
    "source_sha256",
    "requirements_sha256"
  ],
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "source_spec_id": {
      "type": "string"
    },
    "function_id": {
      "type": "string"
    },
    "precondition_expr": {
      "type": "string"
    },
    "source_sha256": {
      "type": "string"
    },
    "requirements_sha256": {
      "type": "string"
    },
    "ensures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "clause_id",
          "expr",
          "guard_expr"
        ],
        "properties": {
          "clause_id": {
            "type": "string"
          },
          "expr": {
            "type": "string"
          },
          "guard_expr": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "required_snapshots": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
