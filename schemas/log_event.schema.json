{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Spec Agent observation event v2",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "sequence",
    "timestamp",
    "elapsed_ms",
    "level",
    "event",
    "context",
    "details"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "run_id": {
      "type": "string"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string"
    },
    "elapsed_ms": {
      "type": "number",
      "minimum": 0
    },
    "level": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "event": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.]*$"
    },
    "context": {
      "type": "object"
    },
    "details": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
