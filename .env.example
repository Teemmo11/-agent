# OpenAI-compatible provider API base URL, including /v1 when required.
LLM_BASE_URL=
# Use the model identifier provided by your API provider.
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60
TOOL_TIMEOUT_SECONDS=60
LLM_MAX_CONCURRENCY=2
VERIFY_MAX_CONCURRENCY=1
# Resolve this exact executable name through PATH: c2btor or an extended cbmc.
CBMC_COMMAND=c2btor
# Versioned C2Btor source-map profile: LP64 (--64) or ILP32 (--32).
C2BTOR_DATA_MODEL=LP64
