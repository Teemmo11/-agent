{
  "type":"object",
  "required":["finding_id","spec_id","clause_ids","dimension","code","severity","evidence_kind","claim_status","evidence_ids","explanation","suggested_action"],
  "additionalProperties":false,
  "properties":{
    "finding_id":{"type":"string","pattern":"FIND-[a-f0-9]{16}"},
    "spec_id":{"type":"string","minLength":1},
    "clause_ids":{"type":"array","items":{"type":"string"}},
    "dimension":{"enum":["alignment","strength","nontriviality","coverage","redundancy","clarity","usefulness","consistency"]},
    "code":{"type":"string","pattern":"[A-Z][A-Z0-9_]{0,95}"},
    "severity":{"enum":["INFO","LOW","MEDIUM","HIGH"]},
    "evidence_kind":{"enum":["DETERMINISTIC","FORMAL","LLM_JUDGMENT","HUMAN_REFERENCE"]},
    "claim_status":{"enum":["OBSERVED","PROVED","DISPROVED","UNKNOWN","JUDGMENT","REVIEW_REQUIRED"]},
    "evidence_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
    "explanation":{"type":"string","minLength":1,"maxLength":4096},
    "suggested_action":{"type":"string","minLength":1,"maxLength":4096}
  }
}
